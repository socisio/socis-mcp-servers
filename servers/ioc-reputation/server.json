{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SOCIS/virustotal",
  "description": "MCP server for querying VirusTotal API with comprehensive security analysis tools.",
  "repository": {
    "url": "https://github.com/SOCIS/mcp-virustotal",
    "source": "github"
  },
  "version": "1.0.25",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@socis/mcp-virustotal",
      "version": "1.0.25",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VIRUSTOTAL_API_KEY",
          "description": "Your VirusTotal API key",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
