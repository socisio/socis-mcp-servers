{
  "name": "@socis/mcp-ioc-reputation",
  "mcpName": "io.github.SOCIS/virustotal",
  "version": "1.0.25",
  "description": "MCP server for VirusTotal API integration",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "socis-mcp-ioc-reputation": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsc -w",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "virustotal",
    "security"
  ],
  "author": "SOCIS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/socisio/socis-mcp-servers.git",
    "directory": "servers/ioc-reputation"
  },
  "dependencies": {
    "axios": ">=1.4.0 <1.14.1",
    "dotenv": "^16.4.5",
    "fastmcp": "~3.25.4",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.3.3"
  }
}
