# System files
.DS_Store
Thumbs.db

# package-lock.json is COMMITTED here, unlike upstream.
# These are servers we ship, not a library: npm ci needs a
# lockfile (CI failed with EUSAGE without one), and Dependabot
# cannot propose precise transitive fixes without it.
